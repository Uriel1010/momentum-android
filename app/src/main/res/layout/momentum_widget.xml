<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
 <LinearLayout android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:focusable="true" android:clickable="true" android:paddingBottom="8dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MOMENTUM" android:textSize="12sp" android:textColor="#D7FF3F" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_empty" android:textSize="20sp" android:textStyle="bold" android:textColor="#FAF7F2" android:maxLines="3" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_open" android:textSize="14sp" android:textColor="#C7C5C2" android:maxLines="2" android:ellipsize="end"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/widget_capture" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/widget_capture" android:textColor="#0F0F10" android:backgroundTint="#D7FF3F" android:textAllCaps="false"/>
  <Button android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/widget_refresh" android:textColor="#FAF7F2" android:backgroundTint="#29292B" android:textAllCaps="false"/>
 </LinearLayout>
</LinearLayout>